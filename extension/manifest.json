{
  "manifest_version": 3,
  "name": "Le 11 parfait pour MPG",
  "version": "1.0.0",
  "description": "Affiche ton meilleur 11, ton banc et la probabilité de titularisation de tes joueurs directement sur le site MPG.",
  "icons": { "128": "icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Le 11 parfait" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "host_permissions": ["https://*.vercel.app/*", "http://localhost/*"],
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [
    {
      "matches": ["https://mpg.football/*", "https://*.mpg.football/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
